# ==============================================================================
# ShortForge Environment Configuration
# ==============================================================================

# Database: Shared Neon PostgreSQL Connection (Used by both Vercel & Render)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# AI Scripting & Research
GEMINI_API_KEY="AIzaSy..."

# Stock Footage & Visual Assets
PEXELS_API_KEY="563492ad6f91700001000001..."

# Cloud Video & Audio Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional Cloudflare Image API (Fallback already included via Pexels & AI image prompt)
CF_ACCOUNT_ID=""
CF_API_TOKEN=""

# YouTube Data API & OAuth (Optional, for auto-publishing from Settings)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="https://your-domain.vercel.app/api/auth/youtube/callback"

# ==============================================================================
# Vercel + Render Hybrid Configuration
# ==============================================================================

# ON VERCEL ONLY:
# 1. Provide the public HTTPS URL of your deployed Render worker service
RENDER_WORKER_URL="https://shortforge-render-worker.onrender.com"
NEXT_PUBLIC_RENDER_WORKER_URL="https://shortforge-render-worker.onrender.com"

# 2. Shared bearer token between Vercel and Render (prevents unauthorized requests)
WORKER_SECRET="generate-a-random-32-char-secret"

# ON RENDER ONLY:
# Set these in Render's environment settings (or via render.yaml):
# IS_RENDER_WORKER="true"
# DATA_DIR="/tmp/tars-data"
# WORKER_SECRET="same-random-32-char-secret"
# DATABASE_URL="same-neon-db-url"
# CLOUDINARY_CLOUD_NAME="same-cloud-name"
# CLOUDINARY_API_KEY="same-api-key"
# CLOUDINARY_API_SECRET="same-api-secret"
